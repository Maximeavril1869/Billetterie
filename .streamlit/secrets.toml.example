# Copie ce fichier en secrets.toml (en local) ou colle son contenu dans
# Streamlit Cloud > App > Settings > Secrets. Ne jamais publier les vraies valeurs.
GRIST_DOC_ID = "identifiant-du-document-grist"
GRIST_API_KEY = "cle-api-grist"
GRIST_SERVER = "https://docs.getgrist.com"
GRIST_DOC_URL = "https://docs.getgrist.com/xxxxxxxx/Nom-du-document"   # facultatif, bouton admin
GMAIL_USER = "adresse@gmail.com"
GMAIL_APP_PASSWORD = "mot-de-passe-application-16-caracteres"
APP_URL = "https://ton-appli.streamlit.app"   # sert aux liens d'annulation dans les mails
ADMIN_PASSWORD = "choisis-un-mot-de-passe"
